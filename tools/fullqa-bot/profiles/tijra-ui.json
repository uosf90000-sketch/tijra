{
  "name": "Tijra UI",
  "workflows": [
    {
      "id": "TIJRA-UI-REGISTER-SUPPLIER",
      "module": "Auth/UI",
      "steps": [
        { "type": "goto", "path": "/login?mode=register" },
        { "type": "click", "selector": "button:has-text(\"مورد\")" },
        { "type": "select", "selector": "#businessActivity", "value": "OTHER" },
        { "type": "fill", "selector": "#name", "value": "FullQA Supplier ${RUN_ID}" },
        { "type": "fill", "selector": "#phone", "value": "0500000000" },
        { "type": "fill", "selector": "#businessName", "value": "FullQA Supplier ${RUN_ID}" },
        { "type": "fill", "selector": "#city", "value": "جدة" },
        { "type": "fill", "selector": "#email", "value": "supplier.${RUN_ID}@example.test" },
        { "type": "fill", "selector": "#password", "value": "${PASSWORD}" },
        { "type": "click", "selector": "button[type=submit]" },
        { "type": "wait", "ms": 900 },
        { "type": "expectUrl", "contains": "/marketplace/seller" },
        { "type": "screenshot", "name": "supplier-created" }
      ]
    },
    {
      "id": "TIJRA-UI-REGISTER-RETAILER",
