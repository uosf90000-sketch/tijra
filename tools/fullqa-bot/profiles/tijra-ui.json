      "steps": [
        { "type": "goto", "path": "/login?mode=register" },
        { "type": "click", "selector": "button:has-text(\"تاجر\")" },
        { "type": "select", "selector": "#businessActivity", "value": "GROCERY" },
        { "type": "fill", "selector": "#name", "value": "FullQA Retailer ${RUN_ID}" },
        { "type": "fill", "selector": "#businessName", "value": "FullQA Retailer ${RUN_ID}" },
        { "type": "fill", "selector": "#city", "value": "جدة" },
        { "type": "fill", "selector": "#email", "value": "retailer.${RUN_ID}@example.test" },
        { "type": "fill", "selector": "#password", "value": "${PASSWORD}" },
        { "type": "click", "selector": "button[type=submit]" },
        { "type": "wait", "ms": 900 },
        { "type": "expectUrl", "contains": "/marketplace" },
        { "type": "screenshot", "name": "retailer-created" }
      ]
    },
    {
      "id": "TIJRA-UI-REGISTER-BOTH",
      "module": "Auth/UI",
      "steps": [
        { "type": "goto", "path": "/login?mode=register" },
        { "type": "click", "selector": "button:has-text(\"الاثنان\")" },
        { "type": "select", "selector": "#businessActivity", "value": "GROCERY" },
        { "type": "fill", "selector": "#name", "value": "FullQA Both ${RUN_ID}" },
        { "type": "fill", "selector": "#businessName", "value": "FullQA Both ${RUN_ID}" },
        { "type": "fill", "selector": "#city", "value": "جدة" },
        { "type": "fill", "selector": "#email", "value": "both.${RUN_ID}@example.test" },
        { "type": "fill", "selector": "#password", "value": "${PASSWORD}" },
        { "type": "click", "selector": "button[type=submit]" },
        { "type": "wait", "ms": 900 },
        { "type": "expectUrl", "contains": "/marketplace" },
        { "type": "screenshot", "name": "both-created" }
      ]
    }
  ]
}
