{
  "name": "Example App",
  "workflows": [
    {
      "id": "AUTH-REGISTER-001",
      "module": "Auth",
      "steps": [
        { "type": "goto", "path": "/register" },
        { "type": "fill", "selector": "input[name=name]", "value": "FullQA ${RUN_ID}" },
        { "type": "fill", "selector": "input[name=email]", "value": "${EMAIL}" },
        { "type": "fill", "selector": "input[name=password]", "value": "${PASSWORD}" },
        { "type": "click", "selector": "button[type=submit]" },
        { "type": "wait", "ms": 700 },
        { "type": "screenshot", "name": "after-register" }
      ]
    }
  ]
}
