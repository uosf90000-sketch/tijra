generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  ACCOUNTANT
  SUPPLIER
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  phone       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
}

model Business {
  id             String          @id @default(cuid())
  name           String
  commercialName String?
  taxNumber      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberships    Membership[]
  products       Product[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  sales          Sale[]
  expenses       Expense[]
  employees      Employee[]
  payrollRuns    PayrollRun[]
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  role       UserRole
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

model Product {
  id            String              @id @default(cuid())
  businessId    String
  name          String
  sku           String?
  barcode       String?
  unit          String              @default("piece")
  salePrice     Decimal             @db.Decimal(12, 2)
  averageCost   Decimal             @default(0) @db.Decimal(12, 2)
  quantity      Decimal             @default(0) @db.Decimal(14, 3)
  reorderPoint  Decimal             @default(0) @db.Decimal(14, 3)
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierItems SupplierProduct[]
  orderItems    PurchaseOrderItem[]
  saleItems     SaleItem[]

  @@unique([businessId, sku])
  @@index([businessId, barcode])
}

model Supplier {
  id             String            @id @default(cuid())
  businessId     String
  name           String
  phone          String?
  email          String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@index([businessId, name])
}

model SupplierProduct {
  id           String   @id @default(cuid())
  supplierId   String
  productId    String
  supplierSku  String?
  price        Decimal  @db.Decimal(12, 2)
  minOrderQty  Decimal? @db.Decimal(14, 3)
  lastQuotedAt DateTime @default(now())
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  businessId   String
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  expectedTotal Decimal             @default(0) @db.Decimal(12, 2)
  notes        String?
  orderedAt    DateTime?
  receivedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  items        PurchaseOrderItem[]

  @@index([businessId, status])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  orderedQty      Decimal       @db.Decimal(14, 3)
  receivedQty     Decimal       @default(0) @db.Decimal(14, 3)
  unitCost        Decimal       @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@unique([purchaseOrderId, productId])
}

model Sale {
  id         String     @id @default(cuid())
  businessId String
  total      Decimal    @db.Decimal(12, 2)
  costTotal  Decimal    @default(0) @db.Decimal(12, 2)
  soldAt     DateTime   @default(now())
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items      SaleItem[]

  @@index([businessId, soldAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  category    String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, expenseDate])
}

model Employee {
  id            String        @id @default(cuid())
  businessId    String
  name          String
  phone         String?
  jobTitle      String?
  baseSalary    Decimal       @db.Decimal(12, 2)
  active        Boolean       @default(true)
  hiredAt       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payrollItems  PayrollItem[]
}

model PayrollRun {
  id          String        @id @default(cuid())
  businessId  String
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollStatus @default(DRAFT)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       PayrollItem[]

  @@index([businessId, periodStart])
}

model PayrollItem {
  id           String     @id @default(cuid())
  payrollRunId String
  employeeId   String
  baseSalary   Decimal    @db.Decimal(12, 2)
  allowances   Decimal    @default(0) @db.Decimal(12, 2)
  deductions   Decimal    @default(0) @db.Decimal(12, 2)
  advances     Decimal    @default(0) @db.Decimal(12, 2)
  netSalary    Decimal    @db.Decimal(12, 2)
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
}
