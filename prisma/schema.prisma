generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  ACCOUNTANT
  SUPPLIER
  STAFF
}

enum AppPermission {
  CASHIER
  INVENTORY
  PURCHASES
  ACCOUNTING
}

enum BusinessScale {
  MICRO
  SMALL
  MEDIUM
  ENTERPRISE
}

enum OperatingModel {
  FOOD_TRUCK
  SHOP
  RESTAURANT
  WHOLESALE
  SERVICES
  MANUFACTURING
  LOGISTICS
  MIXED
}

model Organization {
  id          String     @id @default(cuid())
  name        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  businesses  Business[]
}

enum BusinessType {
  RETAILER
  SUPPLIER
  BOTH
}

enum BusinessActivity {
  GROCERY
  ELECTRONICS
  PHARMACY
  RESTAURANT
  CAFE
  FASHION
  BEAUTY
  HARDWARE
  OFFICE
  OTHER
}

enum MarketplaceOrderStatus {
  PLACED
  ACCEPTED
  RECEIVED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseInvoiceStatus {
  DRAFT
  REVIEW
  APPROVED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

enum JournalStatus {
  DRAFT
  POSTED
}

enum JournalSide {
  DEBIT
  CREDIT
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum StockMovementType {
  OPENING_BALANCE
  SALE
  PURCHASE_RECEIPT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  phone        String?
  passwordHash String?
  totpSecretEncrypted        String?
  totpPendingSecretEncrypted String?
  totpEnabledAt             DateTime?
  mfaFailedAttempts         Int       @default(0)
  mfaLockedUntil            DateTime?
  mfaLastVerifiedStep       Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  sessions     Session[]
  mfaRecoveryCodes MfaRecoveryCode[]
  employees    Employee[]
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeBusinessId String?

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Business {
  id                         String                @id @default(cuid())
  name                       String
  commercialName             String?
  taxNumber                  String?
  city                       String?
  currency                   String                @default("SAR")
  businessType               BusinessType          @default(RETAILER)
  businessActivity           BusinessActivity      @default(GROCERY)
  businessScale              BusinessScale         @default(SMALL)
  operatingModel             OperatingModel        @default(SHOP)
  workspaceModules           String[]              @default([])
  locationAccessEnforced     Boolean               @default(false)
  locationAccessGrants       MembershipLocationGrant[]
  purchaseApprovalEnabled    Boolean               @default(false)
  purchaseApprovalThreshold  Decimal               @default(5000) @db.Decimal(12, 2)
  payrollDualApprovalEnabled Boolean               @default(false)
  journalDualApprovalEnabled Boolean               @default(false)
  stockReasonRequired        Boolean               @default(false)
  stockValueReviewThreshold  Decimal               @default(5000) @db.Decimal(12, 2)
  expenseOwnerThreshold      Decimal               @default(5000) @db.Decimal(12, 2)
  cashierMaxDiscountPercent  Decimal               @default(100) @db.Decimal(5, 2)
  organizationId             String?
  organization               Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  memberships                Membership[]
  products                   Product[]
  suppliers                  Supplier[]
  purchaseOrders             PurchaseOrder[]
  purchaseOrderApprovals      PurchaseOrderApproval[]
  purchaseInvoices           PurchaseInvoice[]
  supplierPriceHistory       SupplierPriceHistory[]
  stockMovements             StockMovement[]
  inventoryAuditEvents       InventoryAuditEvent[]
  sales                      Sale[]
  expenses                   Expense[]
  employees                  Employee[]
  payrollRuns                PayrollRun[]
  marketplaceListings        MarketplaceListing[]  @relation("MarketplaceSellerListings")
  marketplaceOrdersAsBuyer   MarketplaceOrder[]    @relation("MarketplaceBuyer")
  marketplaceOrdersAsSeller  MarketplaceOrder[]    @relation("MarketplaceSeller")
  favoriteSuppliers          FavoriteSupplier[]    @relation("FavoriteBuyer")
  favoritedBy                FavoriteSupplier[]    @relation("FavoriteSeller")
  paymentSettlements         PaymentSettlement[]
  financialAccounts          FinancialAccount[]
  fiscalPeriods              FiscalPeriod[]
  journalEntries             JournalEntry[]

  @@index([organizationId])
}

model Membership {
  id          String          @id @default(cuid())
  userId      String
  businessId  String
  role        UserRole
  permissions AppPermission[] @default([])
  locationGrants MembershipLocationGrant[]
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId, role])
}

/// A location is the tenant-local stable UUID from LOCATION_CONFIG; a grant
/// must always be checked alongside membership.businessId on every operation.
model MembershipLocationGrant {
  id           String      @id @default(cuid())
  businessId   String
  membershipId String
  locationId   String
  createdAt    DateTime    @default(now())
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  membership   Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, locationId])
  @@index([businessId, locationId])
}

model FavoriteSupplier {
  id               String   @id @default(cuid())
  buyerBusinessId  String
  sellerBusinessId String
  createdAt        DateTime @default(now())
  buyer            Business @relation("FavoriteBuyer", fields: [buyerBusinessId], references: [id], onDelete: Cascade)
  seller           Business @relation("FavoriteSeller", fields: [sellerBusinessId], references: [id], onDelete: Cascade)

  @@unique([buyerBusinessId, sellerBusinessId])
  @@index([sellerBusinessId])
}

model MarketplaceListing {
  id               String                 @id @default(cuid())
  sellerBusinessId String
  name             String
  sku              String?
  barcode          String?
  category         String?
  activity         BusinessActivity       @default(GROCERY)
  unit             String                 @default("piece")
  price            Decimal                @db.Decimal(12, 2)
  quantity         Decimal                @default(0) @db.Decimal(14, 3)
  minOrderQty      Decimal                @default(1) @db.Decimal(14, 3)
  active           Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  seller           Business               @relation("MarketplaceSellerListings", fields: [sellerBusinessId], references: [id], onDelete: Cascade)
  orderItems       MarketplaceOrderItem[]

  @@index([sellerBusinessId, active])
  @@index([activity, active])
  @@index([barcode, active])
  @@index([name, active])
}

model MarketplaceOrder {
  id               String                 @id @default(cuid())
  buyerBusinessId  String
  sellerBusinessId String
  status           MarketplaceOrderStatus @default(PLACED)
  expectedTotal    Decimal                @default(0) @db.Decimal(12, 2)
  notes            String?
  acceptedAt       DateTime?
  receivedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  buyer            Business               @relation("MarketplaceBuyer", fields: [buyerBusinessId], references: [id], onDelete: Cascade)
  seller           Business               @relation("MarketplaceSeller", fields: [sellerBusinessId], references: [id], onDelete: Cascade)
  items            MarketplaceOrderItem[]

  @@index([buyerBusinessId, createdAt])
  @@index([sellerBusinessId, status, createdAt])
}

model MarketplaceOrderItem {
  id                 String             @id @default(cuid())
  marketplaceOrderId String
  listingId          String
  quantity           Decimal            @db.Decimal(14, 3)
  unitPrice          Decimal            @db.Decimal(12, 2)
  order              MarketplaceOrder   @relation(fields: [marketplaceOrderId], references: [id], onDelete: Cascade)
  listing            MarketplaceListing @relation(fields: [listingId], references: [id])

  @@index([listingId])
}

model Product {
  id                   String                @id @default(cuid())
  businessId           String
  name                 String
  sku                  String?
  barcode              String?
  imageUrl             String?
  category             String?
  unit                 String                @default("piece")
  salePrice            Decimal               @db.Decimal(12, 2)
  averageCost          Decimal               @default(0) @db.Decimal(12, 2)
  quantity             Decimal               @default(0) @db.Decimal(14, 3)
  reorderPoint         Decimal               @default(0) @db.Decimal(14, 3)
  targetCoverageDays   Int                   @default(7)
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierItems        SupplierProduct[]
  orderItems           PurchaseOrderItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  supplierPriceHistory SupplierPriceHistory[]
  saleItems            SaleItem[]
  stockMovements       StockMovement[]

  @@unique([businessId, sku])
  @@index([businessId, barcode])
  @@index([businessId, active])
}

model Supplier {
  id               String            @id @default(cuid())
  businessId       String
  name             String
  phone            String?
  email             String?
  notes             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products         SupplierProduct[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  priceHistory      SupplierPriceHistory[]

  @@index([businessId, name])
}

model SupplierProduct {
  id           String   @id @default(cuid())
  supplierId   String
  productId    String
  supplierSku  String?
  price        Decimal  @db.Decimal(12, 2)
  minOrderQty  Decimal? @db.Decimal(14, 3)
  lastQuotedAt DateTime @default(now())
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId, price])
}

model SupplierPriceHistory {
  id           String   @id @default(cuid())
  businessId   String
  supplierId   String
  productId    String
  price        Decimal  @db.Decimal(12, 2)
  minOrderQty  Decimal? @db.Decimal(14, 3)
  source       String   @default("QUOTE")
  recordedAt   DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId, supplierId, productId, recordedAt])
  @@index([businessId, recordedAt])
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  businessId       String
  supplierId       String
  orderNumber      String?
  requestedByUserId String?
  status           PurchaseOrderStatus @default(DRAFT)
  expectedTotal    Decimal             @default(0) @db.Decimal(12, 2)
  notes            String?
  orderedAt        DateTime?
  receivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  items            PurchaseOrderItem[]
  purchaseInvoices PurchaseInvoice[]
  approvals        PurchaseOrderApproval[]

  @@index([businessId, status])
  @@index([supplierId, createdAt])
}

model PurchaseOrderApproval {
  id            String        @id @default(cuid())
  businessId    String
  purchaseOrderId String
  actorUserId   String
  actorName     String
  decision      String
  reason        String?
  decidedAt     DateTime      @default(now())
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([businessId, decidedAt])
  @@index([purchaseOrderId, decidedAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  orderedQty      Decimal       @db.Decimal(14, 3)
  receivedQty     Decimal       @default(0) @db.Decimal(14, 3)
  unitCost        Decimal       @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@unique([purchaseOrderId, productId])
}

model PurchaseInvoice {
  id              String                @id @default(cuid())
  businessId      String
  supplierId      String
  purchaseOrderId String?
  invoiceNumber   String?
  invoiceKey      String?               @unique
  declaredTotal   Decimal?              @db.Decimal(12, 2)
  declaredVat     Decimal?              @db.Decimal(12, 2)
  reviewNote      String?
  status          PurchaseInvoiceStatus @default(DRAFT)
  invoiceTotal    Decimal               @default(0) @db.Decimal(12, 2)
  imageUrl        String?
  issuedAt        DateTime?
  approvedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  business         Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier         Supplier               @relation(fields: [supplierId], references: [id])
  purchaseOrder    PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id])
  items            PurchaseInvoiceItem[]

  @@index([businessId, createdAt])
}

model PurchaseInvoiceItem {
  id                String          @id @default(cuid())
  purchaseInvoiceId String
  productId         String
  invoicedQty       Decimal         @db.Decimal(14, 3)
  receivedQty       Decimal         @default(0) @db.Decimal(14, 3)
  unitCost          Decimal         @db.Decimal(12, 2)
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])

  @@unique([purchaseInvoiceId, productId])
}

model StockMovement {
  id         String            @id @default(cuid())
  businessId String
  productId  String
  type       StockMovementType
  quantity   Decimal           @db.Decimal(14, 3)
  unitCost   Decimal?          @db.Decimal(12, 2)
  sourceType String?
  sourceId   String?
  note       String?
  occurredAt DateTime          @default(now())
  createdAt  DateTime          @default(now())
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId, occurredAt])
  @@index([productId, occurredAt])
}

model InventoryAuditEvent {
  id               String   @id @default(cuid())
  businessId       String
  action           String
  listingId        String?
  orderId          String?
  itemName         String?
  quantity         Decimal? @db.Decimal(14, 3)
  previousQuantity Decimal? @db.Decimal(14, 3)
  newQuantity      Decimal? @db.Decimal(14, 3)
  actorUserId      String?
  actorName        String
  actorRole        String?
  note             String?
  occurredAt       DateTime @default(now())
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, occurredAt])
  @@index([businessId, action, occurredAt])
  @@index([listingId, occurredAt])
  @@index([orderId])
}

model Sale {
  id            String        @id @default(cuid())
  businessId    String
  invoiceNumber String?
  total         Decimal       @db.Decimal(12, 2)
  costTotal     Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  soldAt        DateTime      @default(now())
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items         SaleItem[]

  @@index([businessId, soldAt])
  @@index([businessId, invoiceNumber])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model PaymentSettlement {
  id            String        @id @default(cuid())
  businessId    String
  provider      String
  paymentMethod PaymentMethod
  salesDate     DateTime
  settledAt     DateTime
  grossAmount   Decimal       @db.Decimal(12, 2)
  fees          Decimal       @default(0) @db.Decimal(12, 2)
  netAmount     Decimal       @db.Decimal(12, 2)
  reference     String?
  source        String        @default("MANUAL")
  note          String?
  createdAt     DateTime      @default(now())
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, salesDate])
  @@index([businessId, paymentMethod, salesDate])
  @@index([businessId, settledAt])
  @@unique([businessId, provider, reference])
}

/// Manual double-entry foundation. This does not automatically post existing sales
/// or purchases; it remains separate until reconciled integration is implemented.
model FinancialAccount {
  id          String            @id @default(cuid())
  businessId  String
  code        String
  name        String
  kind        LedgerAccountType
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines       JournalLine[]

  @@unique([businessId, code])
  @@index([businessId, active])
}

model FiscalPeriod {
  id             String             @id @default(cuid())
  businessId     String
  title          String
  periodStart    DateTime
  periodEnd      DateTime
  status         FiscalPeriodStatus @default(OPEN)
  closedAt       DateTime?
  closedByUserId String?
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries        JournalEntry[]

  @@index([businessId, periodStart, periodEnd])
}

model JournalEntry {
  id                String        @id @default(cuid())
  businessId        String
  periodId          String
  entryDate         DateTime
  description       String
  reference         String?
  status            JournalStatus @default(DRAFT)
  createdByUserId   String
  postedByUserId    String?
  postedAt          DateTime?
  createdAt         DateTime      @default(now())
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  period            FiscalPeriod  @relation(fields: [periodId], references: [id])
  lines             JournalLine[]

  @@index([businessId, status, entryDate])
  @@index([periodId, status])
}

model JournalLine {
  id             String      @id @default(cuid())
  journalEntryId String
  accountId      String
  side           JournalSide
  amount         Decimal     @db.Decimal(18, 2)
  description    String?
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        FinancialAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, journalEntryId])
}

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  createdByUserId String?
  category    String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, expenseDate])
}

model Employee {
  id               String        @id @default(cuid())
  businessId       String
  userId           String?
  name             String
  phone            String?
  jobTitle         String?
  baseSalary       Decimal       @db.Decimal(12, 2)
  defaultAllowance Decimal       @default(0) @db.Decimal(12, 2)
  active           Boolean       @default(true)
  hiredAt          DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  payrollItems     PayrollItem[]

  @@unique([businessId, userId])
  @@index([businessId, active])
  @@index([userId])
}

model PayrollRun {
  id          String        @id @default(cuid())
  businessId  String
  createdByUserId String?
  approvedByUserId String?
  paidByUserId String?
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollStatus @default(DRAFT)
  approvedAt  DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       PayrollItem[]

  @@index([businessId, periodStart])
}

model PayrollItem {
  id           String     @id @default(cuid())
  payrollRunId String
  employeeId   String
  baseSalary   Decimal    @db.Decimal(12, 2)
  allowances   Decimal    @default(0) @db.Decimal(12, 2)
  deductions   Decimal    @default(0) @db.Decimal(12, 2)
  advances     Decimal    @default(0) @db.Decimal(12, 2)
  netSalary    Decimal    @db.Decimal(12, 2)
  note         String?
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
}
