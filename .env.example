# PostgreSQL connection string. On Railway use: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/tijra"

# Session lifetime in days.
AUTH_SESSION_DAYS="30"

# OCR upload limit in bytes (default 8 MB).
OCR_MAX_BYTES="8388608"

# Random secret of at least 32 characters used to sign supplier order links.
# Generate it privately in the hosting dashboard; never commit the real value.
SUPPLIER_LINK_SECRET="replace-with-a-private-random-value-at-least-32-chars"
